<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Full Name Input -->
    <EditText
        android:id="@+id/editTextFullName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Full Name"
        android:inputType="textPersonName" />

    <!-- Position Input -->
    <EditText
        android:id="@+id/editTextPosition"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Position"
        android:layout_marginTop="8dp"
        android:inputType="text" />

    <!-- Resume URL Input -->
    <EditText
        android:id="@+id/editTextResumeUrl"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Resume URL"
        android:layout_marginTop="8dp"
        android:inputType="textUri" />

    <!-- Notification Time Input -->
    <EditText
        android:id="@+id/editTextNotificationTime"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Notification Time"
        android:layout_marginTop="8dp"
        android:inputType="time" />

    <!-- Notification Message Input -->
    <EditText
        android:id="@+id/editTextNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Notification Message"
        android:layout_marginTop="8dp"
        android:inputType="text" />

    <!-- Button to Select Profile Image -->
    <Button
        android:id="@+id/buttonSelectImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Profile Image"
        android:layout_marginTop="16dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/buttonSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_marginTop="16dp" />
</LinearLayout>
